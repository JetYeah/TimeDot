<Window x:Class="TimeDot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TimeDot" Width="90" Height="90"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI" TextOptions.TextRenderingMode="ClearType">

    <!-- 透明异形窗口:用 WindowChrome 玻璃层而非 AllowsTransparency。
         分层窗口(AllowsTransparency)会让 WebView2 等 HwndHost 子控件收不到鼠标输入,
         且渲染性能更差;GlassFrameThickness=-1 的整窗玻璃 + 透明背景是标准替代方案。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 缓动资源必须先于引用它的 storyboard 定义(StaticResource 不可前向引用) -->
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <SineEase x:Key="EaseSoft" EasingMode="EaseInOut"/>



        <!-- 展开面板 -->
        <Storyboard x:Key="PanelIn">
            <DoubleAnimation Storyboard.TargetName="PanelCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="PanelScale" Storyboard.TargetProperty="ScaleY"
                             From="0.93" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="PanelScale" Storyboard.TargetProperty="ScaleX"
                             From="0.97" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 快捷回复面板(双击球唤出) -->
        <Storyboard x:Key="QuickIn">
            <DoubleAnimation Storyboard.TargetName="QuickCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="QuickScale" Storyboard.TargetProperty="ScaleY"
                             From="0.93" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="QuickScale" Storyboard.TargetProperty="ScaleX"
                             From="0.97" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 待办面板(环形菜单唤出) -->
        <Storyboard x:Key="TodoIn">
            <DoubleAnimation Storyboard.TargetName="TodoCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="TodoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.93" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="TodoScale" Storyboard.TargetProperty="ScaleX"
                             From="0.97" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 环形菜单(单击球唤出,点扇区进入功能):淡入 + 从球心弹出 -->
        <Storyboard x:Key="RadialIn">
            <DoubleAnimation Storyboard.TargetName="RadialHost" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="RadialScale" Storyboard.TargetProperty="ScaleX"
                             From="0.82" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="RadialScale" Storyboard.TargetProperty="ScaleY"
                             From="0.82" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 新行高亮闪现 -->
        <Storyboard x:Key="RowFlash">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.85" To="0" Duration="0:0:1.1"
                             EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 细滚动条:珍珠在细针上 —— 12px 命中区中央一根 1px 淡针,
             滑块是 6px 径向渐变圆珠(内容多时延展为细胶囊),与内容天然留出空隙 -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <!-- 细针:命中区中央一根 1px 淡墨线 -->
                            <Rectangle Width="1" Fill="#1F26231E" HorizontalAlignment="Center"
                                       Margin="0,2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinHeight="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <!-- 珍珠:偏上高光的径向渐变圆珠;高度随内容比例延展 -->
                                                    <Border x:Name="pearl" Width="6" CornerRadius="3" HorizontalAlignment="Center">
                                                        <Border.Background>
                                                            <RadialGradientBrush GradientOrigin="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                                                                <GradientStop Color="#FFF6F2E9" Offset="0"/>
                                                                <GradientStop Color="#FFBDB6A5" Offset="0.6"/>
                                                                <GradientStop Color="#FF8F8776" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 悬停:朱砂薄纱轻笼珍珠 -->
                                                    <Border x:Name="halo" Width="6" CornerRadius="3" Background="#3DC04522"
                                                            HorizontalAlignment="Center" Opacity="0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 待办筛选芯片(单选组:全部/当日/当周/待完成/已完成) -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="9" Background="#0A000000" Padding="9,3">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="10.5"
                                       Foreground="{StaticResource TextSub}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#16000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC04522"/>
                                <Setter TargetName="t" Property="Foreground" Value="#FFF7F5EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签建议芯片(气泡内可点选的历史标签) -->
        <Style x:Key="SuggestChip" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="c" CornerRadius="9" Background="#12C04522"
                                BorderBrush="#33C04522" BorderThickness="1" Padding="8,2">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" Foreground="#FF5F594E"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="c" Property="Background" Value="#26C04522"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角输入框外壳 -->
        <Style x:Key="FieldShell" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#59C04522"/>
                    <Setter Property="Background" Value="#16C04522"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Background 默认 x:Null;收起球态时由代码动态换成 alpha=1/255 的洗刷刷子
         (SetScrub,见 MainWindow.xaml.cs):非空背景会被真实绘制,全窗重渲染时把
         客户区每个角落重写为近全透明,冲掉重定向表面里滞留的旧帧像素(右下角骑角
         残影的根治手段)。只在球独占窗口时开——此时 WebView2 HWND 盖满全窗,这层
         背景仅在球的透明四角露出,肉眼不可见;其余状态(环形菜单/面板/吸边条)必须
         关闭,否则裸露的透明区域会把背景透出来,在玻璃合成下染成可见的方块。 -->
    <Grid x:Name="Root" Background="{x:Null}">

        <!-- ============ 悬浮球(emotion-ball via WebView2) ============ -->
        <Grid x:Name="BallHost" Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Top"
              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="True">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <!-- 球体交互由 JS 侧处理,通过 postMessage 通知 C# -->
            <wv2:WebView2 x:Name="BallWeb" Width="84" Height="84"/>
        </Grid>

        <!-- ============ 记录面板 ============ -->
        <Border x:Name="PanelHost" Visibility="Collapsed" Width="402" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="0,0,0,0">
            <Border x:Name="PanelCard" CornerRadius="14" Opacity="0"
                    Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" Margin="10"
                    RenderTransformOrigin="0.5,0.08">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.32" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- 毛玻璃质感层:细噪点 + 顶部冷光 sheen(铺满含内边距,不拦截交互) -->
                    <Border x:Name="NoiseLayer" CornerRadius="13" Margin="1" Opacity="0.05" IsHitTestVisible="False"/>
                    <Border CornerRadius="13" Margin="1" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3CFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.22"/>
                                <GradientStop Color="#00000000" Offset="0.75"/>
                                <GradientStop Color="#16000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 头部 -->
                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="TimeDot" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBlock Text="工时速记" FontSize="10" Margin="8,1,0,0"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- pin:固定面板,失焦/Esc/点球都不收起;再点一次解锁 -->
                            <Button x:Name="BtnPin" Click="PinClick" Cursor="Hand" Focusable="False"
                                    ToolTip="固定面板（失焦不收起）">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock x:Name="ic" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnCollapse"
                                    Click="CollapseClick" Cursor="Hand" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 快速新建 -->
                    <Grid Grid.Row="1" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.9*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Border Style="{StaticResource FieldShell}" Height="32">
                                    <TextBox x:Name="InProject" VerticalContentAlignment="Center" BorderThickness="0"
                                             Background="Transparent" Foreground="{StaticResource TextMain}"
                                             CaretBrush="{StaticResource Accent}" FontSize="12.5"
                                             FontFamily="Consolas, Cascadia Mono"
                                             KeyDown="ProjectKeyDown"/>
                                </Border>
                                <TextBlock Text="项目号 / Project" IsHitTestVisible="False" FontSize="11"
                                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                           Margin="11,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=InProject}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Border Style="{StaticResource FieldShell}" Height="32">
                                    <TextBox x:Name="InUser" VerticalContentAlignment="Center" BorderThickness="0"
                                             Background="Transparent" Foreground="{StaticResource TextMain}"
                                             CaretBrush="{StaticResource Accent}" FontSize="12.5"
                                             KeyDown="UserKeyDown"/>
                                </Border>
                                <TextBlock Text="用户" IsHitTestVisible="False" FontSize="11"
                                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                           Margin="11,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=InUser}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Button Grid.Column="1" Click="AddClick" Cursor="Hand" Margin="6,0,0,0" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="7" Height="32" Padding="13,0" MinWidth="58"
                                            Background="{StaticResource AccentSoft}" BorderBrush="#4DC04522"
                                            BorderThickness="1">
                                        <TextBlock Text="＋ 记录" FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#2EC04522"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#1FC04522"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 搜索 -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FieldShell}" Height="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBox Grid.Column="1" x:Name="InSearch" VerticalContentAlignment="Center"
                                         BorderThickness="0" Background="Transparent" FontSize="12"
                                         Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource Accent}"
                                         TextChanged="SearchChanged" KeyDown="SearchKeyDown"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="搜索 项目 / 用户 / 标签 / 日期" IsHitTestVisible="False" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                   Margin="24,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" x:Name="BtnClear" Click="ClearSearchClick" Cursor="Hand"
                                VerticalAlignment="Center" Margin="4,0,0,0" Focusable="False" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="4" Padding="3">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource TextSub}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 记录列表:虚拟化 + 回收,长期大量记录也不卡 -->
                    <Grid Grid.Row="3" MinHeight="64">
                        <ItemsControl x:Name="List" MaxHeight="396">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="9,8" Margin="0,0,0,7"
                                                Background="Transparent" BorderBrush="Transparent"
                                                BorderThickness="1" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 行首:开始/停止 -->
                                                <Button Grid.Column="0" Width="36" Height="36" Cursor="Hand"
                                                        Click="TimerClick" Tag="{Binding}" Focusable="False"
                                                        ToolTip="开始 / 停止计时" VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="c" Width="34" Height="34" CornerRadius="17"
                                                                    Background="Transparent"
                                                                    BorderBrush="#47C04522" BorderThickness="1.2">
                                                                <TextBlock x:Name="g" Text="&#xE768;"
                                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                           Foreground="{StaticResource Accent}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter TargetName="c" Property="Background" Value="{StaticResource Accent}"/>
                                                                    <Setter TargetName="c" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                    <Setter TargetName="g" Property="Text" Value="&#xE71A;"/>
                                                                    <Setter TargetName="g" Property="Foreground" Value="#FFFFF6E8"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="c" Property="Background" Value="#1AC04522"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Grid Grid.Column="1" Margin="9,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 行 1:项目 · 用户 … 时长 / 删除 -->
                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Project}" FontSize="13" FontWeight="SemiBold"
                                                                       FontFamily="Consolas, Cascadia Mono"
                                                                       Foreground="#FF26231E" TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="150" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding User}" FontSize="11" Margin="8,1,0,0"
                                                                       Foreground="{StaticResource TextSub}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="100"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="dur" Text="{Binding DurationText}" FontSize="13"
                                                                       FontFamily="Consolas, Cascadia Mono"
                                                                       VerticalAlignment="Center"
                                                                       MouseLeftButtonUp="DurationClick"
                                                                       ToolTip="停止计时后点击可手动修改时长">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FF4A443A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button Click="TagBtnClick" Tag="{Binding}" Focusable="False" Cursor="Hand"
                                                                    Margin="7,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="添加标签(回车确认)">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" CornerRadius="4" Padding="3,1">
                                                                            <TextBlock x:Name="tag" Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="tag" Property="Foreground" Value="{StaticResource Accent}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Click="ShotClick" Tag="{Binding}" Focusable="False" Cursor="Hand"
                                                                    Margin="7,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="截图:框选屏幕区域 (Ctrl+V 可粘贴剪贴板图片)">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" CornerRadius="4" Padding="3,1">
                                                                            <TextBlock x:Name="cam" Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="cam" Property="Foreground" Value="{StaticResource Accent}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Click="DeleteClick" Tag="{Binding}" Focusable="False"
                                                                    Cursor="Hand" Margin="7,0,-3,0" VerticalAlignment="Center"
                                                                    ToolTip="删除">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" CornerRadius="4" Padding="3,1">
                                                                            <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="9" Foreground="{StaticResource TextFaint}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding ConfirmDelete}" Value="True">
                                                                                <Setter TargetName="x" Property="Text" Value="确认删除?"/>
                                                                                <Setter TargetName="x" Property="FontFamily" Value="Segoe UI"/>
                                                                                <Setter TargetName="x" Property="FontSize" Value="9"/>
                                                                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 行 2:短语标签(回车添加,点 × 删除,可按标签检索) -->
                                                    <StackPanel Grid.Row="1" Margin="0,3,0,1">
                                                        <ItemsControl ItemsSource="{Binding Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="9" Background="#18C04522"
                                                                            BorderBrush="#3CC04522" BorderThickness="1"
                                                                            Margin="0,0,5,4" Padding="8,1.5,3,2.5">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding}" FontSize="11" MaxWidth="120"
                                                                                       Foreground="#FF5F594E" TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"/>
                                                                            <Button Click="TagRemoveClick" Focusable="False" Cursor="Hand"
                                                                                    Margin="3,0,-1,0" VerticalAlignment="Center" ToolTip="删除标签">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="Transparent" CornerRadius="4" Padding="3,1">
                                                                                            <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                                                       FontSize="8" Foreground="#FF98917F"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- 行 3:自由文字备注(可多行) -->
                                                    <Grid Grid.Row="2" Margin="0,3,0,1">
                                                        <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0" Background="Transparent" FontSize="11.5"
                                                                 Foreground="#FF5F594E" CaretBrush="{StaticResource Accent}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120"
                                                                 VerticalScrollBarVisibility="Auto" Padding="0" LostFocus="NoteLostFocus"/>
                                                        <TextBlock Text="记点什么吧~" IsHitTestVisible="False" FontSize="11"
                                                                   Foreground="#FF98917F" VerticalAlignment="Top" Margin="1,1,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Note}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- 行 4:截图缩略图(点击看原图,× 删除) -->
                                                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Shots}" Margin="0,3,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,7,6">
                                                                    <Button Click="ShotOpenClick" Tag="{Binding}" Cursor="Hand"
                                                                            Focusable="False" ToolTip="{Binding Tip}" Padding="0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="b" CornerRadius="6" BorderBrush="#3CC04522"
                                                                                        BorderThickness="1" Background="#0A000000" Padding="2">
                                                                                    <Image Source="{Binding Thumb}" Height="62" Stretch="Uniform"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Click="ShotRemoveClick" Tag="{Binding}" Focusable="False" Cursor="Hand"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                                                            Width="16" Height="16" ToolTip="删除截图">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="#E6F7F5EF" CornerRadius="8">
                                                                                    <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                                               FontSize="8" Foreground="#FF98917F"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 行 5:元信息 -->
                                                    <TextBlock Grid.Row="4" Text="{Binding MetaText}" FontSize="10"
                                                               Foreground="{StaticResource TextFaint}" Margin="0,1,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0DC04522"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                                                <Setter TargetName="dur" Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0A000000"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHint" Text="暂无记录 — 填写项目号和用户开始" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,26,0,10" Visibility="Collapsed"/>
                    </Grid>

                    <!-- 底部 -->
                    <Border Grid.Row="4" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                            Margin="2,8,2,0" Padding="0,7,0,0">
                        <Grid>
                            <TextBlock x:Name="FooterText" Text="共 0 条 · 今日 0:00" FontSize="10.5"
                                       Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                            <TextBlock Text="JSONL · 本地" FontSize="9" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============ 环形菜单(单击球唤出,扇区由代码生成) ============ -->
        <Grid x:Name="RadialHost" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"
              VerticalAlignment="Top" IsHitTestVisible="True">
            <Canvas x:Name="RadialCanvas" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="RadialScale"/>
                </Canvas.RenderTransform>
            </Canvas>
        </Grid>

        <!-- ============ 球替身(环形菜单期间顶替真球) ============
             真球是 WebView2,其方形 HWND 在 Win32 层永远盖住 WPF 渲染——
             环形展开时若不撤下,斜向扇区的内缘会被球光晕方形吃掉。
             替身不参与 RadialHost 淡入:顶替/恢复都是瞬间无缝切换。 -->
        <Grid x:Name="BallStandin" Visibility="Collapsed" Width="70" Height="70"
              HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" ToolTip="收起菜单">
            <Ellipse Fill="#FFFCF9F2" Stroke="#2626231E" StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.16" Direction="270"/>
                </Ellipse.Effect>
            </Ellipse>
            <!-- 两枚墨色竖条眼(待机放空神态) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Width="4.5" Height="13" RadiusX="2.25" RadiusY="2.25" Fill="#FF26231E"/>
                <Rectangle Width="4.5" Height="13" RadiusX="2.25" RadiusY="2.25" Fill="#FF26231E" Margin="7.5,0,0,0"/>
            </StackPanel>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="StandinBreath"/>
            </Grid.RenderTransform>
        </Grid>

        <!-- ============ 待办面板(环形菜单唤出) ============ -->
        <Border x:Name="TodoHost" Visibility="Collapsed" Width="342" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="0,0,0,0">
            <Border x:Name="TodoCard" CornerRadius="14" Opacity="0"
                    Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" Margin="10" RenderTransformOrigin="0.5,0.08">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TodoScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.32" Direction="270"/>
                </Border.Effect>
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 头部 -->
                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="待办" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TodoCount" Text="0 项待办" FontSize="10" Margin="8,1,0,0"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnTodoPin" Click="TodoPinClick" Cursor="Hand" Focusable="False"
                                    ToolTip="固定面板（失焦不收起）">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock x:Name="tic" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="TodoCloseClick" Cursor="Hand" Focusable="False" ToolTip="收起">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 新增(回车添加) -->
                    <Grid Grid.Row="1" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Border Style="{StaticResource FieldShell}" Height="32">
                                <TextBox x:Name="TodoInput" VerticalContentAlignment="Center" BorderThickness="0"
                                         Background="Transparent" FontSize="12"
                                         Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource Accent}"
                                         KeyDown="TodoInputKeyDown"/>
                            </Border>
                            <TextBlock Text="新待办,回车添加" IsHitTestVisible="False" FontSize="11"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TodoInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Click="TodoAddClick" Cursor="Hand" Margin="6,0,0,0" Focusable="False"
                                ToolTip="添加">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="7" Background="#12C04522"
                                            BorderBrush="#33C04522" BorderThickness="1" Width="32" Height="32">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#26C04522"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 筛选:当日 / 当周 / 待完成 / 已完成(单选,点选即过滤) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="TodoFilter" IsChecked="True"
                                     Tag="All" Content="全部" Click="TodoFilterClick" ToolTip="全部待办"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="TodoFilter"
                                     Tag="Today" Content="当日" Click="TodoFilterClick" ToolTip="今天添加的"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="TodoFilter"
                                     Tag="Week" Content="当周" Click="TodoFilterClick" ToolTip="本周添加的"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="TodoFilter"
                                     Tag="Open" Content="待完成" Click="TodoFilterClick" ToolTip="未完成"/>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="TodoFilter"
                                     Tag="Done" Content="已完成" Click="TodoFilterClick" ToolTip="已完成"/>
                    </StackPanel>

                    <!-- 列表(勾选完成,× 删除;条目下方带创建时间) -->
                    <Grid Grid.Row="3">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="TodoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Button Click="TodoToggleClick" Tag="{Binding}" Cursor="Hand"
                                                    Focusable="False" ToolTip="点击切换完成状态">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="tb" CornerRadius="8" Background="#0A000000"
                                                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                Padding="8,5">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border x:Name="box" Width="15" Height="15" CornerRadius="4"
                                                                            BorderBrush="#99C04522" BorderThickness="1.2"
                                                                            Background="Transparent" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="tt" Text="{Binding Text}" FontSize="12"
                                                                               Foreground="{StaticResource TextMain}" TextWrapping="Wrap"
                                                                               MaxHeight="52" TextTrimming="CharacterEllipsis"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <!-- 创建时间:添加时自动记录,当日/当周筛选的依据 -->
                                                                <TextBlock Text="{Binding CreatedText}" FontSize="9.5"
                                                                           Foreground="{StaticResource TextFaint}" Margin="23,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter TargetName="tt" Property="Foreground" Value="{StaticResource TextFaint}"/>
                                                                <Setter TargetName="tt" Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter TargetName="box" Property="Background" Value="#FFC04522"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="tb" Property="Background" Value="#16C04522"/>
                                                                <Setter TargetName="tb" Property="BorderBrush" Value="#59C04522"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Click="TodoRemoveClick" Tag="{Binding}" Focusable="False" Cursor="Hand"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                                    Width="18" Height="18" ToolTip="删除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#E6F7F5EF" CornerRadius="9">
                                                            <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="8" Foreground="#FF98917F"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="TodoEmptyHint" Text="没有待办 — 添加一条开始" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                                   Margin="0,20,0,12" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============ 快捷回复面板(双击球唤出,点击即复制) ============ -->
        <Border x:Name="QuickHost" Visibility="Collapsed" Width="342" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="0,0,0,0">
            <Border x:Name="QuickCard" CornerRadius="14" Opacity="0"
                    Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" Margin="10" RenderTransformOrigin="0.5,0.08">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="QuickScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.32" Direction="270"/>
                </Border.Effect>
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 头部 -->
                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="快捷回复" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBlock Text="点击即复制" FontSize="10" Margin="8,1,0,0"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- pin:固定面板,失焦/Esc/点球都不收起;再点一次解锁 -->
                            <Button x:Name="BtnQuickPin" Click="QuickPinClick" Cursor="Hand" Focusable="False"
                                    ToolTip="固定面板（失焦不收起）">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock x:Name="qic" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnQuickCollapse" Click="QuickCloseClick" Cursor="Hand" Focusable="False"
                                    ToolTip="收起">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="5,3">
                                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#12000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 搜索(实时过滤,回车复制首条) -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Border Style="{StaticResource FieldShell}" Height="30">
                            <TextBox x:Name="QuickSearch" VerticalContentAlignment="Center" BorderThickness="0"
                                     Background="Transparent" FontSize="12"
                                     Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource Accent}"
                                     TextChanged="QuickSearchChanged" KeyDown="QuickSearchKeyDown"/>
                        </Border>
                        <TextBlock Text="搜索关键词…回车复制首条" IsHitTestVisible="False" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 新增(回车添加;图片按钮挑图,也可在输入框 Ctrl+V 粘贴) -->
                    <Grid Grid.Row="2" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Border Style="{StaticResource FieldShell}" Height="32">
                                <TextBox x:Name="QuickInput" VerticalContentAlignment="Center" BorderThickness="0"
                                         Background="Transparent" FontSize="12"
                                         Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource Accent}"
                                         KeyDown="QuickInputKeyDown"/>
                            </Border>
                            <TextBlock Text="新短语,回车添加" IsHitTestVisible="False" FontSize="11"
                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=QuickInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Click="QuickImageClick" Cursor="Hand" Margin="6,0,0,0" Focusable="False"
                                ToolTip="添加图片：选择图片文件，或在左侧输入框 Ctrl+V 直接粘贴">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="7" Background="#0D000000"
                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1" Width="32" Height="32">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource TextSub}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Click="QuickAddClick" Cursor="Hand" Margin="6,0,0,0" Focusable="False"
                                ToolTip="添加">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="7" Background="#12C04522"
                                            BorderBrush="#33C04522" BorderThickness="1" Width="32" Height="32">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#26C04522"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 列表(点击复制文本/图片,× 删除) -->
                    <Grid Grid.Row="3">
                        <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="QuickList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Button Click="QuickCopyClick" Tag="{Binding}" Cursor="Hand"
                                                    Focusable="False" ToolTip="点击复制到剪贴板(图片条目复制图)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="qb" CornerRadius="8" Background="#0A000000"
                                                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                Padding="10,6">
                                                            <Grid>
                                                                <!-- 文本条目 -->
                                                                <TextBlock x:Name="qt" Text="{Binding Text}" FontSize="12"
                                                                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"
                                                                           MaxHeight="56" TextTrimming="CharacterEllipsis"/>
                                                                <!-- 图片条目:缩略图 + 标题小字 -->
                                                                <StackPanel x:Name="qimg" Orientation="Horizontal" Visibility="Collapsed">
                                                                    <Border CornerRadius="5" Background="#0D000000" Padding="2">
                                                                        <Image Source="{Binding Thumb}" MaxHeight="52" MaxWidth="120"
                                                                               Stretch="Uniform"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Text}" FontSize="11" MaxWidth="140"
                                                                               Foreground="{StaticResource TextSub}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="qb" Property="Background" Value="#16C04522"/>
                                                                <Setter TargetName="qb" Property="BorderBrush" Value="#59C04522"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter TargetName="qt" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="qimg" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Click="QuickRemoveClick" Tag="{Binding}" Focusable="False" Cursor="Hand"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                                    Width="18" Height="18" ToolTip="删除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#E6F7F5EF" CornerRadius="9">
                                                            <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="8" Foreground="#FF98917F"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource Danger}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="QuickEmptyHint" Text="还没有快捷回复 — 上方输入后回车添加"
                                   FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                                   Margin="0,20,0,12" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============ 标签气泡(行首“标签”按钮弹出) ============ -->
        <Popup x:Name="TagPopup" AllowsTransparency="True" StaysOpen="False"
               Placement="Bottom" PopupAnimation="Fade">
            <Border CornerRadius="10" Background="#F5F7F5EF" BorderBrush="#4DC04522" BorderThickness="1"
                    Width="228" Padding="10" Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.22" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="新标签" FontSize="10.5" Foreground="#FF98917F" Margin="1,0,0,4"/>
                    <Border CornerRadius="7" Background="#0F000000" BorderBrush="#16000000"
                            BorderThickness="1" Padding="8,0">
                        <TextBox x:Name="TagPopupInput" BorderThickness="0" Background="Transparent" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Foreground="#FF26231E" CaretBrush="{StaticResource Accent}" Padding="0"
                                 KeyDown="TagPopupInputKeyDown" Height="26"/>
                    </Border>
                    <TextBlock x:Name="TagPopupSuggestLabel" Text="历史标签(点选添加)" FontSize="10.5"
                               Foreground="#FF98917F" Margin="1,9,0,4"/>
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="TagPopupSuggest"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ 时长修改气泡(停止计时后点时长弹出) ============ -->
        <Popup x:Name="TimeEditPopup" AllowsTransparency="True" StaysOpen="False"
               Placement="Bottom" PopupAnimation="Fade">
            <Border CornerRadius="10" Background="#F5F7F5EF" BorderBrush="#4DC04522" BorderThickness="1"
                    Width="228" Padding="10" Margin="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.22" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TimeEditTitle" Text="修改总时长" FontSize="10.5" Foreground="#FF98917F"
                               Margin="1,0,0,4"/>
                    <Border CornerRadius="7" Background="#0F000000" BorderBrush="#16000000"
                            BorderThickness="1" Padding="8,0">
                        <TextBox x:Name="TimeEditInput" BorderThickness="0" Background="Transparent" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Foreground="#FF26231E" CaretBrush="{StaticResource Accent}" Padding="0"
                                 KeyDown="TimeEditInputKeyDown" Height="26"/>
                    </Border>
                    <TextBlock Text="支持 1:30:00 / 1:30 / 90m / 45s / 1.5h；纯数字按分钟。回车确认，Esc 取消"
                               FontSize="10" Foreground="{StaticResource TextFaint}" Margin="1,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ 吸边小条 ============ -->
        <Border x:Name="StripHost" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="4" Background="#E8F4F0E6" BorderBrush="#4DC04522" BorderThickness="1"
                Cursor="SizeAll" MouseLeftButtonDown="StripDown" MouseMove="StripMove"
                MouseLeftButtonUp="StripUp" MouseEnter="StripEnter" MouseLeave="StripLeave">
            <Border x:Name="StripCore" Background="#80C04522" CornerRadius="2" Opacity="0.35"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
